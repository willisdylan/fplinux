# SPDX-License-Identifier: GPL-2.0-only
config DRM_RUIO_F286
	bool "Ruio F286 LCDC display"
	depends on DRM && MACH_RUIO_F286
	select DRM_UMS9117
	select DRM_UMS9117_LCM
	select DRM_UMS9117_WAKE_REINIT
	help
	  Drive the Ruio F286 GC9307 panel through the UMS9117 parallel LCM/DBI
	  interface with atomic RGB565 and NV16 modesetting, bounded transfer
	  completion and LCD backlight control. The in-kernel console uses
	  DRM fbdev emulation.
